# PostgreSQL connection used by the locally-run FastAPI application.
DATABASE_URL=postgresql+psycopg://codebase_qa:codebase_qa@localhost:5432/codebase_qa

# Application settings
APP_NAME=Codebase QA V2
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
DEFAULT_TOP_K=5

# LLM settings used by POST /ask. Base URL is optional for the normal OpenAI endpoint.
# For an unauthenticated local compatible server, set its accepted placeholder API key.
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL_NAME=
LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=2

# Docker Compose PostgreSQL settings
POSTGRES_DB=codebase_qa
POSTGRES_USER=codebase_qa
POSTGRES_PASSWORD=codebase_qa
POSTGRES_PORT=5432
